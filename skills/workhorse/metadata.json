{
  "name": "workhorse",
  "version": "1.0.0",
  "description": "Workhorse — set up and audit the harness a coding agent works inside: planning with task specs, reviewer-gated verification, feature delivery, batched push, and pull requests on any git host.",
  "license": "MIT",
  "author": "Tony Baidoo",
  "repository": "https://github.com/tcrz/workhorse",
  "derivedFrom": "https://github.com/walkinglabs/learn-harness-engineering",
  "languages": [
    "en"
  ],
  "compatibility": {
    "node": ">=18",
    "agents": [
      "claude-code",
      "codex-cli",
      "cursor",
      "windsurf",
      "generic"
    ]
  },
  "entryPoint": "SKILL.md",
  "references": [
    "references/memory-persistence-pattern.md",
    "references/context-engineering-pattern.md",
    "references/skill-runtime-pattern.md",
    "references/tool-registry-pattern.md",
    "references/multi-agent-pattern.md",
    "references/lifecycle-bootstrap-pattern.md",
    "references/gotchas.md"
  ],
  "triggers": [
    "workhorse",
    "harness engineering",
    "agent reliability",
    "session continuity",
    "memory persistence",
    "verification workflow",
    "scope control",
    "lifecycle management",
    "AGENTS.md",
    "CLAUDE.md",
    "feature tracking",
    "session handoff",
    "multi-agent coordination",
    "context engineering",
    "tool safety",
    "permission pipeline"
  ],
  "bundled": {
    "scripts": [
      "scripts/workhorse-create.mjs",
      "scripts/workhorse-validate.mjs",
      "scripts/workhorse-upgrade.mjs",
      "scripts/workhorse-report.mjs",
      "scripts/workhorse-benchmark.mjs",
      "scripts/self-test.mjs",
      "scripts/lib/workhorse-utils.mjs"
    ],
    "assets": [],
    "templates": [
      "templates/agents.md",
      "templates/feature-list.json",
      "templates/feature-list.schema.json",
      "templates/init.sh",
      "templates/progress.md",
      "templates/session-handoff.md",
      "templates/plan.md",
      "templates/plan.schema.json",
      "templates/overview-plan.md",
      "templates/overview-plan.schema.json",
      "templates/ui-build.md"
    ]
  }
}
